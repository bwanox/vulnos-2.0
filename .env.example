# === VulnOS 2.0 Environment Configuration ===

# Nebius Token Factory
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_API_BASE=https://api.studio.nebius.com/v1

# NVIDIA Nemotron Models (via Nebius)
NEMOTRON_NANO_MODEL=nvidia/Nemotron-Mini-4B-Instruct
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-4-340B-Instruct

# Tavily API
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub (for automated PR creation)
GITHUB_TOKEN=your_github_pat_here

# Sandbox Configuration
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_TIMEOUT=120

# Telemetry HUD
TELEMETRY_PORT=3000
TELEMETRY_WS_PORT=8765

# Logging
LOG_LEVEL=INFO
